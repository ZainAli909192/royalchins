generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  type        CategoryType
  description String   @default("")
  isActive    Boolean  @default(true)
  items       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]

  @@index([type, isActive])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  type             CategoryType
  status           ProductStatus @default(Draft)
  regularPrice     Decimal       @db.Decimal(10, 2)
  salePrice        Decimal?      @db.Decimal(10, 2)
  quantity         Int           @default(0)
  shortDescription String
  description      String
  gender           String?
  age              String?
  color            String?
  brand            String?
  size             String?
  compatibility    String?
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images           ProductImage[]
  orderItems       OrderItem[]
  inventoryEvents  InventoryAdjustment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([type, status])
  @@index([categoryId])
  @@index([quantity])
}

model InventoryAdjustment {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  previous  Int
  quantity  Int
  action    InventoryAction
  reason    String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model Order {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  customerName  String
  email         String
  phone         String
  total         Decimal        @db.Decimal(10, 2)
  paymentStatus PaymentStatus  @default(Pending)
  paymentMethod PaymentMethod
  orderStatus   OrderStatus    @default(Pending)
  notes         String?
  items         OrderItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([orderStatus, createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  sortOrder Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

enum CategoryType {
  Animal
  Accessory
}

enum ProductStatus {
  Draft
  Active
  Inactive
}

enum InventoryAction {
  Add
  Remove
  Set
}

enum OrderStatus {
  Pending
  Confirmed
  Processing
  Delivered
  Cancelled
}

enum PaymentStatus {
  Paid
  Pending
  Failed
  Refunded
}

enum PaymentMethod {
  Card
  Tamara
  Tabby
  Cash
}
